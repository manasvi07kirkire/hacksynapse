# Node 22 LTS. Never prefix secrets with NEXT_PUBLIC_.
# Supabase: pooled PostgreSQL runtime connection. Set the connection limit for your plan.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10&connect_timeout=10&sslmode=require"
# Direct connection (or Supabase session pooler) for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?connect_timeout=10&sslmode=require"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SEARCHOPS_API_KEY=""
# JSON object mapping project IDs to distinct random keys; read/write only that project.
SEARCHOPS_PROJECT_KEYS="{}"
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_SLUG=""
GITHUB_APP_WEBHOOK_SECRET=""
OPENROUTER_API_KEY=""
# Explicit model ID; no automatic model race, paid-model substitution or fake fallback.
OPENROUTER_MODEL=""
ALLOW_LLM_FALLBACK="false"
USE_PLAYWRIGHT="false"
SEARCHOPS_LOCAL_DEMO="false"
SEARCHOPS_ALLOW_PRIVATE_CRAWL="false"
SEARCHOPS_ALLOW_PAT="false"
GITHUB_TOKEN=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
